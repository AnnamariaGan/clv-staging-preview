---
// Root: reindirizza immediatamente alla lingua principale (/it/).
// Su hosting statico il meta refresh è l'unico redirect disponibile: se il server
// lo permette, configurare un 301 verso /it/ e questa pagina diventa superflua.
import { localizedPath } from '../i18n/config';

const target = localizedPath('it', 'home');
---
<!doctype html>
<html lang="it">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <link rel="canonical" href={new URL(target, Astro.site)} />
    <title>Camping Lido Valderice — Campeggio sul mare a Valderice, Trapani</title>
  </head>
  <body>
    <p><a href={target}>Camping Lido Valderice</a></p>
  </body>
</html>